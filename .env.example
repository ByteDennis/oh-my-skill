# oh-my-skill standalone env template — copy to .env and fill in.
# `docker compose` in this dir auto-loads .env. The Settings drawer (skill ns)
# overrides these at runtime.

# --- Host ---
HOST_UID=1001
HOST_GID=1001
HOST_HOME=/home/you
HOST_HOSTNAME=your-host
HOST_SSH_KEY=/root/.ssh/id_rsa

# --- Skill-card git repos (Settings → sync) ---
SKILL_GITHUB_REPO=git@github.com:you/skills.git
SKILL_PRIVATE_GITHUB_REPO=git@github.com:you/private-skills.git
SCHOLAR_GITHUB_REPO=git@github.com:you/review.git

# --- API keys ---
OPENAI_API_KEY=
GEMINI_API_KEY=
GITHUB_TOKEN=
CLAUDE_CODE_OAUTH_TOKEN=
S2_API_KEY=
FIGMA_TOKEN=
